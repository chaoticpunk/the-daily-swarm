# Copy to .env.local and fill in. Never commit .env.local.
# All values are server-side only. Do not prefix any secret with NEXT_PUBLIC_.

# ---------- LLM (OpenAI-compatible, server-side) ----------
# Preferred: NEAR AI Cloud
NEARAI_CLOUD_API_KEY=
NEARAI_CLOUD_BASE_URL=https://cloud-api.near.ai
NEARAI_MODEL=Qwen/Qwen3.8-27B

# Alternative OpenAI-compatible provider (used when the NEARAI_* values are empty)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Set false if the provider rejects response_format=json_object
LLM_JSON_MODE=true
# Optional chat-template kwargs as a JSON object. For Qwen thinking models:
# LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
LLM_CHAT_TEMPLATE_KWARGS=
# Per-call timeout. Each API route stays under 60s.
LLM_TIMEOUT_MS=25000

# ---------- NEAR (testnet only) ----------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_TREASURY_ACCOUNT=treasury.daily-swarm.testnet

# Only the treasury key is needed server-side. It signs payouts.
# Format: ed25519:...
NEAR_TREASURY_PRIVATE_KEY=

# Optional account overrides. Defaults are the sub-accounts below.
NEAR_EDITOR_ACCOUNT=editor.daily-swarm.testnet
NEAR_REPORTER_NEAR_ACCOUNT=reporter-near.daily-swarm.testnet
NEAR_REPORTER_AI_ACCOUNT=reporter-ai.daily-swarm.testnet
NEAR_REPORTER_MARKETS_ACCOUNT=reporter-markets.daily-swarm.testnet
NEAR_FACT_CHECKER_ACCOUNT=fact-checker.daily-swarm.testnet

# The app refuses payout signing unless NEAR_NETWORK=testnet.
# There is no mainnet mode.
